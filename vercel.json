{
  "buildCommand": "npx expo export -p web",
  "outputDirectory": "dist",
  "framework": null,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "gems.thesiqaapp.com"
        }
      ],
      "destination": "https://www.siqa.us/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "marketplace.thesiqaapp.com"
        }
      ],
      "destination": "https://shop.siqa.us/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/watch/:id",
      "destination": "/api/og?type=video&id=:id"
    },
    {
      "source": "/gems",
      "has": [
        {
          "type": "query",
          "key": "videoId"
        }
      ],
      "destination": "/api/og?type=short"
    },
    {
      "source": "/product/:id",
      "destination": "/api/og?type=product&id=:id"
    },
    {
      "source": "/seed/:id",
      "destination": "/api/og?type=seed&id=:id"
    },
    {
      "source": "/speaker/:id",
      "destination": "/api/og?type=speaker&id=:id"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ],
  "functions": {
    "api/og.js": {
      "includeFiles": "dist/index.html"
    }
  }
}
