<?xml version="1.0" encoding="utf-8"?>
<!-- 320x180 TV banner: the gold mark on night navy. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="rectangle"><solid android:color="#0A0F1C" /><size android:width="320dp" android:height="180dp" /></shape></item>
    <item android:gravity="center" android:width="96dp" android:height="96dp">
        <shape android:shape="rectangle"><solid android:color="#141C30" /><corners android:radius="24dp" /></shape>
    </item>
</layer-list>
