{
  "expo": {
    "name": "Siqa",
    "slug": "siqa",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0D0B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.solostack.siqa",
      "infoPlist": {
        "NSCameraUsageDescription": "Siqa uses your camera to record videos and take product and profile photos.",
        "NSMicrophoneUsageDescription": "Siqa uses your microphone to record audio for the videos you post.",
        "NSPhotoLibraryUsageDescription": "Siqa uses your photo library to upload videos, thumbnails, product photos and profile photos.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Siqa uses your location to show local businesses, organizations and events near you."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0F1C"
      },
      "package": "com.solostack.siqa",
      "permissions": [
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Siqa",
      "shortName": "Siqa",
      "themeColor": "#0A0F1C",
      "backgroundColor": "#0A0F1C"
    },
    "scheme": "siqa",
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.siqa.app",
          "enableGooglePay": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Siqa uses your location to show local businesses, organizations and events near you."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f183978e-cbe5-4b59-9029-6f71e5a3596a"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/f183978e-cbe5-4b59-9029-6f71e5a3596a",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
